# 构建产物
bin/
obj/
publish/
dist/
*.user

# 开发期截图与诊断文件
shot_*.png
diag*.txt

# 原项目参考资料（第三方代码，仅本地研究用，不随本仓库分发）
reference/

# 本地覆盖配置
*.local.json

# 作者本机的构建脚本：里面的令牌路径与内网地址只适用于那一台机器，不进仓库
build-local.ps1

# Go 服务端构建产物与运行日志
# 构建产物后缀不统一（Windows 是 .exe，交叉编译出的 Linux 二进制是裸名），
# 所以按前缀排掉，别只认 *.exe。
server-go/enf-collector*
server-go/*.log

# Python 字节码（server/ 下的旧采集端曾把 __pycache__ 一并提交进来）
__pycache__/
*.pyc
